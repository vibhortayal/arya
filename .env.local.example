# Settings for running Arya on your computer (compose.yaml).
# Copy this file to .env, put your key on the first line, then run
#   docker compose up --build
# and open http://localhost:8080. Never commit .env (it is git-ignored).

# Required for anything AI: your own Meta Model API key, made at
# dev.meta.ai (API keys, Create API key). It starts with LLM_.
MODEL_API_KEY=

# Where data is kept: json (files in a Docker volume) needs nothing else.
ARYA_STORE=json

# Receipt photo reader: auto (Spark first, Wonder re-reads flagged
# photos), spark or wonder.
ARYA_PHOTO_READER=auto

# Spark runs on Meta's Standard plan.
ARYA_SPARK_TIER=standard

# Optional: a Baseten key for Muse Spark Open, the staple judge's second
# seat. Leave empty to skip that check; everything else works.
BASETEN_API_KEY=

# Optional: use another port if 8080 is taken.
ARYA_LOCAL_PORT=8080
