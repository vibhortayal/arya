# Arya public site. Caddy obtains and renews the Let's Encrypt certificate
# automatically once DNS points at this VM and ports 80/443 are reachable.
arya-pilot.duckdns.org {
	reverse_proxy api:8000
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# The PWA is same-origin throughout. Scripts: files only, plus
		# the one inline theme script in index.html, allowed by its
		# hash (tests/test_csp.py keeps the hash in step). No
		# 'unsafe-inline' for scripts, so an unescaped name can never
		# run code. Inline style attributes are why style keeps
		# 'unsafe-inline'. frame-ancestors plus X-Frame-Options above
		# keep the app unembeddable.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-ffOUgWC+oQe5hjjtC2q03tUY5ddLf+qvRpLAmXpwVqk='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; font-src 'self' data:; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
}

# Plain HTTP never serves the app (review 2026-10-28, M11): the
# session cookie is Secure, so a login over http:// silently
# failed — the sign-in form "worked" and the app stayed logged
# out. Every plain-HTTP path (the port-80 catch-all and the 8081
# host mapping) now redirects to the canonical HTTPS name.
:80 {
	redir https://arya-pilot.duckdns.org{uri} permanent
}
