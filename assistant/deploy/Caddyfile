# Arya public site. Caddy obtains and renews the Let's Encrypt certificate
# automatically once DNS points at this VM and ports 80/443 are reachable.
# The old DuckDNS name stays up as a permanent redirect (see below).
arya.teamnightshift.org {
	# The app reads an upload whole before it checks the size (12 MB
	# photo, 10 MB PDF or recording), so a huge body could fill the
	# VM's memory first; the demo, open to anyone, reaches the photo
	# doors. Caddy refuses any body over 40 MB with 413 (audit H4,
	# 2026-10-30). 40 MB leaves room for a 12 MB photo sent as base64
	# and for a large Costco order import.
	request_body {
		max_size 40MB
	}
	# Starlette 0.46 handles a crafted Range header in quadratic time
	# (PYSEC-2026-1942), with no sign-in needed. Nothing in the app
	# needs partial downloads, so the header never reaches it; files
	# come whole (audit H2 stopgap until the FastAPI upgrade).
	request_header -Range
	# Owner concept pages (static HTML dropped into ~/arya-pages on
	# the VM; never in the repo). They are single-file mockups with
	# inline scripts, so this path alone relaxes the CSP below; the
	# app itself keeps the strict policy in the fallback handle.
	handle_path /p/* {
		root * /srv/pages
		file_server
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'"
	}
	# Compress text assets (three.js alone is 670 KB). Matched by
	# content type on purpose: the group live stream is text/event-
	# stream and must never be buffered by a compressor.
	encode zstd gzip {
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type application/manifest+json*
			header Content-Type image/svg+xml*
		}
	}
	handle {
		reverse_proxy api:8000
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Only this site may ask for the camera (shelf scan, photos),
		# the microphone (Talk) and location (Near me); the rest is off.
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), payment=(), usb=()"
		# Do not advertise the server software.
		-Server
		# The app is same-origin throughout. Scripts: files only (the
		# React build has no inline script; tests/test_csp.py keeps it
		# so). No 'unsafe-inline' for scripts, so an unescaped name can
		# never run code. Inline style attributes are why style keeps
		# 'unsafe-inline'. frame-ancestors plus X-Frame-Options above
		# keep the app unembeddable.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; font-src 'self' data:; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
}

# The pilot name moved to arya.teamnightshift.org. Keep it alive as a
# permanent redirect so old links, installed PWAs and the Muse connector
# URL still land on the app (sessions do not carry over: new origin).
arya-pilot.duckdns.org {
	redir https://arya.teamnightshift.org{uri} permanent
}

# Plain HTTP never serves the app (review 2026-10-28, M11): the
# session cookie is Secure, so a login over http:// silently
# failed — the sign-in form "worked" and the app stayed logged
# out. Every plain-HTTP path (the port-80 catch-all and the 8081
# host mapping) now redirects to the canonical HTTPS name.
:80 {
	redir https://arya.teamnightshift.org{uri} permanent
}
