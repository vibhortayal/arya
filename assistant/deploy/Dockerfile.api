# The app (web/, React) builds in its own stage into web/dist; the API
# serves it at /. The static folder (pwa/: images, store models,
# three.js, scene.js, manifest, icons) is not part of the build: the API
# serves it beside web/dist and reads the models itself.
FROM node:22-slim AS web
WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
COPY api/requirements.txt ./api/requirements.txt
RUN pip install --no-cache-dir -r api/requirements.txt
COPY api ./api
COPY harness ./harness
COPY prompts ./prompts
COPY golden ./golden
COPY pwa ./pwa
COPY --from=web /app/web/dist ./web/dist
COPY tools/migrate_json_to_pg.py ./tools/migrate_json_to_pg.py
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
