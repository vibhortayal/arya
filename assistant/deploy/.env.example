# Copy to .env ON THE VM ONLY. Never commit a filled .env.
# Owner provisions this himself when the runtime is ready. Leave empty for
# Stage 0 (health checks do not call the Meta API).
MODEL_API_KEY=
# Supabase Postgres (schema "arya" in the team's Supabase project). Role arya_app only;
# never the service key. Fill ON THE VM ONLY. Empty = JSON files.
# ARYA_STORE: json (default) | dual (files + Postgres mirror) | pg
ARYA_STORE=json
DATABASE_URL=
# Google Places API (New) key — the store picker (optional; picker is local without it)
GOOGLE_PLACES_API_KEY=
# Receipt photo reader: wonder (until the Nov 4 amendment ends) | spark
# Changing this needs `docker compose up -d` (recreates the container);
# `docker compose restart` keeps the old environment.
ARYA_PHOTO_READER=wonder
# Muse Spark tier: contributor (default, cheaper, Meta may train on the
# content) | standard (not used for training). `docker compose up -d`.
ARYA_SPARK_TIER=contributor
# New accounts: 0 = closed (default), 1 = open. This is only the
# bootstrap default — the owner can flip it live in Profile.
ARYA_REGISTRATION_OPEN=0
# The owner's account name. Only this account sees the Profile
# registration toggle; unset means nobody can flip it.
ARYA_OWNER_USERNAME=
# Daily model spend caps in USD: app, demo day, one demo visit
ARYA_DAILY_BUDGET_USD=10
ARYA_DEMO_DAILY_BUDGET_USD=20
ARYA_DEMO_SESSION_BUDGET_USD=0.40
# Push reminders (docs/PUSH-REMINDERS.md): 1 = on. Keys come from
# tools/make_vapid_keys.py.
ARYA_PUSH_REMINDERS=0
# Supabase email/Google sign-in (off unless 1)
ARYA_SUPABASE_AUTH=0
# Shared households (lists and receipts for one home): 1 = on (default), 0 = off
ARYA_GROUPS=1
# Demo Town: 1 = the demo household shops at invented stores and a simulated neighbourhood reports
# stock, closures and busy hours (SIMULATED, labelled). After changing it, rerun
# python -m harness.make_demo_household data. 0 = off (default).
ARYA_DEMO_TOWN=0
# Live sync between members: uses Postgres NOTIFY when DATABASE_URL is set; 0 = in-process only
ARYA_LIVE_PG=1
# Push reminders keys (tools/make_vapid_keys.py writes these) and contact
ARYA_VAPID_PUBLIC_KEY=
ARYA_VAPID_PRIVATE_KEY=
ARYA_VAPID_SUBJECT=mailto:admin@example.com
# Supabase Auth (used only when ARYA_SUPABASE_AUTH=1); SIGNUP=0 limits it to existing accounts
SUPABASE_URL=
SUPABASE_ANON_KEY=
ARYA_SUPABASE_SIGNUP=1
# Arya's own Google sign-in (both set = Google's screen names Arya, not Supabase)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Waitlist confirmation email through Resend; empty means no email is sent
RESEND_API_KEY=
ARYA_MAIL_FROM=Arya <arya@mail.teamnightshift.org>
ARYA_PUBLIC_URL=https://arya.teamnightshift.org
# Where replies to the waitlist email go (arya@mail... has no inbox of its own)
ARYA_MAIL_REPLY_TO=support@teamnightshift.org
# Open-weights second judge seat (Baseten)
BASETEN_API_KEY=
ARYA_OPEN_MODEL=
# Demo and feedback limits
ARYA_DEMO_DOOR_RATE=240
ARYA_DEMO_AUTH_RATE=120
ARYA_FEEDBACK_DAILY_CAP=5
ARYA_FEEDBACK_MAIL_CAP=20
# API tokens (agents, scripts): on blocks a short list of routes for them; off lifts it.
ARYA_TOKEN_GUARDS=on
# Guided store scan: frames each account may send per day (~10 walks).
ARYA_SCAN_DAILY_FRAMES=120
# Kroger aisle hint (live lookup, never stored; off by default). Needs both keys.
ARYA_KROGER_AISLES=0
ARYA_KROGER_DAILY_CALLS=800
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Read by deploy/backup.sh only (not passed to the app).
# rclone destination for the off-VM copy, e.g. arya-offvm:arya-backups
ARYA_BACKUP_REMOTE=
# Optional: pg_dump of the arya schema (a direct, non-pooled URL)
ARYA_BACKUP_DATABASE_URL=
# List suggestions as you type. The dictionary and household suggestions
# always work; GUESSES=1 (default) also lets the Meta model complete names
# when MODEL_API_KEY is set, 0 turns that off. GUESS_CAP is model calls per
# day across the app, MIN_HOUSEHOLDS is how many households must have an
# item before it is suggested to others.
ARYA_SUGGEST_GUESSES=1
ARYA_SUGGEST_GUESS_CAP=40
ARYA_SUGGEST_MIN_HOUSEHOLDS=3

# Email to you when someone joins the waitlist. Optional: if empty, ARYA_OPS_EMAIL is used.
# Needs RESEND_API_KEY. After editing run `docker compose up -d` (not restart).
ARYA_WAITLIST_NOTIFY_EMAIL=
ARYA_WAITLIST_NOTIFY_PER_HOUR=10
