# Copy to .env ON THE VM ONLY. Never commit a filled .env.
POSTGRES_PASSWORD=
# Owner provisions this himself when the runtime is ready. Leave empty for
# Stage 0 (health checks do not call the Meta API).
MODEL_API_KEY=
# Supabase Postgres (schema "arya" in khelo-staging-us). Role arya_app only;
# never the service key. Fill ON THE VM ONLY. Empty = JSON files.
# ARYA_STORE: json (default) | dual (files + Postgres mirror) | pg
ARYA_STORE=json
DATABASE_URL=
